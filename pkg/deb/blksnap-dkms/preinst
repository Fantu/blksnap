if dpkg-query -l | grep linux-headers | grep -qw "$(uname -r)"
then
	echo "[TBD]The installed 'linux-headers' package for the current '$(uname -r)' kernel was found."
else
	echo "[TBD]The 'linux-headers' package for the current '$(uname -r)' kernel was not found."
	echo "[TBD]Install the 'linux-headers-$(uname -r)' package into the system."
	echo "[TBD]Or Install latest 'linux-image-$(dpkg --print-architecture)' and 'linux-headers-$(dpkg --print-architecture)' packages and reboot the system."
	exit 1
fi
